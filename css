/*footer*/
footer {
    background-color: black; /* Entire footer background is black */
    color: white; /*text in the footer becomes white */
    padding: 20px;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS',sans-serif;
  }
  
  /* Footer Sections: About, Contact, Policies */
  .footer-sections {
    display: flex;
    justify-content: space-between; /* Align sections across the width */
    text-align: left;
    margin-bottom: 20px; /* Space between sections and the Swiss Made part */
  }
  
  .footer-column {
    flex: 1; /* Each section takes equal width */
    padding: 0 10px; /* Add some horizontal padding */
  }
  
  .footer-column p {
    margin: 5px 0;
  }
  
  .footer-column a {
    color: white;
    text-decoration: none;
  }
  
  .footer-column a:hover {
    text-decoration: underline;
  }
  
  /* Swiss Made Section */
  .swiss-made-section {
    text-align: center;
    margin-top: 40px; /* Space above the Swiss Made section */
  }
  
  .swiss-made {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 50px; /* Space between logo and HR */
  }
  
  .swiss-flag {
    width: 20px;
    height: 20px;
    margin-right: 10px;
  }
  
  .hr {
    border: 1px solid white; /* White line for contrast */
    margin: 20px auto; /* Add space above and below HR */
    width: 90%; /* Center the HR and limit its width */
    margin-bottom: 20px;
  }
  
  .copyright {
    font-size: 14px;
    margin-top: 10px;
    font-weight: bold;
    text-align: center;
  }
  
