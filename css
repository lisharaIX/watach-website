
 /* Home page */
 
 * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}
 
 body {
    margin: 0;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif, sans-serif;
    scroll-behavior: smooth;
  }
   /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 30px 30px;
      background-color: white;
      color: black;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
    }
    
    .logo-container {
      flex-basis: 20%;
    }
    
    .logo-container img {
      max-height: 50px;
    }
    
  
    /*menu*/
    .menu {
      display: flex;
      gap: 15px;
      justify-content: center;
      flex-grow: 1;
    }
    
    .menu a {
      color: black;
      text-decoration: none;
      font-size: 18px;
      text-transform: uppercase;
      padding: 5px 15px;
      transition: background-color 0.3s;
    }
    
    .menu a:hover {
      background-color: red;
      border-radius: 20px;
    }
  
    
    /* main page*/
   /* Discover Section */
  .discover-section {
    position: relative; /* Set position relative for the section */
    background-size: cover;
    background-position: center;
    height: 800px;
    display: flex;
    justify-content: center; /* Center horizontally */
    align-items: center; /* Center vertically */
    color: white;
  }
  
  .discover-section img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute; /* Keep the image as a background */
    top: 0;
    left: 0;
    z-index: 1; /* Ensure the image stays behind the button */
  }
  
  .discover-text {
    position: absolute; /* Position the button in front of the image */
    top: 92%; /* Center the button vertically */
    left: 50%; /* Center the button horizontally */
    transform: translate(-50%, -50%); /* Adjust to perfectly center */
    text-align: center;
    z-index: 2; /* Ensure the button stays on top of the image */
  }
  
  .shop-now-btn {
    padding: 15px 25px;
    background-color: rgb(0, 0, 0);
    color: white;
    font-size: 20px;
    border-radius: 5px;
    transition: background-color 0.3s;
    cursor: pointer;
  }
  
  .shop-now-btn:hover {
    background-color: rgb(241, 12, 12);
  }
  
  
