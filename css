   /* product detail page */
   /* Product Detail Section */
.product-detail {
    margin-top: 120px; /* Account for header */
    padding: 20px;
    text-align: center;
}

.product-detail h1 {
    font-size: 80px;
    font-weight: bold;
    margin-bottom: 60px;
}

/* Product Container */
.product-container {
    display: flex;
    gap: 50px;
    justify-content: center;
    align-items: flex-start;
}

/* Image Gallery */
.image-gallery {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.image-box img {
    width: 250px;
    height: 250px;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
}

/* Description Box */
.description-box {
    background-color: #f9f9f9;
    padding: 20px;
    width: 500px;
    border-radius: 20px;
    box-shadow: 0 6px 8px rgba(0, 0, 0, 0.1);
    text-align: left;
}

.description-box h2 {
    font-size: 24px;
    margin-bottom: 20px;
}

.description-box p {
    margin: 10px 0;
    font-size: 16px;
    color: #555;
}

/* Buttons */
.action-buttons {
    display: flex;
    gap: 10px;
    margin-top: 20px;
}

.action-buttons a {
    display: inline-block;
    padding: 10px 15px;
    font-size: 16px;
    text-decoration: none;
    color: white;
    border-radius: 5px;
    text-align: center;
    transition: background-color 0.3s;
}

.back-button {
    background-color: black;
}

.back-button:hover {
