  /* Box styles */
  .box1 {
    width: 400px;
    height: 400px;
    border: 1px solid #ccc;
    overflow: hidden;
    display: flex;
    flex-direction: column; /* Align children vertically */
    align-items: center; /* Center elements horizontally */
